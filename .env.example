# GapSense Environment Variables

# Primary LLM selection: "groq" or "gemini" (default: "groq")
LLM_PRIMARY=groq

# Groq API Key & Model (Primary provider)
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key & Model (Backup provider)
# Default model: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Safeguards & Testing
# Set to "true" to skip the primary provider and force failover testing
FORCE_FAILOVER=false
