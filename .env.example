# GapSense Environment Variables

# Primary LLM selection: "gemini" or "groq" (default: "gemini")
LLM_PRIMARY=gemini

# Google Gemini API Key & Model
# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key & Model (Backup provider)
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Safeguards & Testing
# Set to "true" to skip the primary provider and force failover testing to Groq
FORCE_FAILOVER=false
